# Copy this file to .env and adjust values as needed. .env is gitignored.
# Every variable shown below matches the local default in app/config.py.

# Database Configuration (PostgreSQL: source of truth for documents + graph extraction JSONB)
# Using the asyncpg driver for asynchronous database I/O
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_docs_db

# Qdrant vector store (single collection used by the Haystack pipeline)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=doc_chunks

# Embedding Model Configuration
# intfloat/multilingual-e5-small produces 384-dimensional dense vectors
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
HF_CACHE_DIR=~/Projects/AI/models/hub

# LLM Service Configuration (any OpenAI-compatible endpoint)
# Local default: llama.cpp / llama-server at http://127.0.0.1:8080/v1 with API key "ollama".
# External OpenAI-compatible providers are a pure config swap, for example:
# LLM_API_BASE=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.8-flash
LLM_API_BASE=http://127.0.0.1:8080/v1
# Local servers use "ollama"; external providers need the real key pasted here.
# This file is a template — secrets live only in the gitignored .env.
LLM_API_KEY=ollama
LLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF

# Output token budget for graph triplet extraction
# EXTRACT_MAX_TOKENS=2048

# Backend API URL for the Streamlit frontend
BACKEND_API_URL=http://localhost:8000

# Neo4j graph store (bolt protocol)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123